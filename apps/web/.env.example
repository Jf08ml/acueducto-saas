# Las TRES variables quedan fijas al compilar (next build): las NEXT_PUBLIC_* se incrustan en el JavaScript y
# los rewrites hacia la API se resuelven en la compilación. Si cambian, hay que volver a compilar.
# En una compilación de producción, si falta NEXT_PUBLIC_PLATFORM_ORIGIN o API_INTERNAL_URL, next build falla.

# Ruta de la API vista desde el navegador. Se deja relativa: el navegador habla con la misma dirección
# (plataforma, subdominio o dominio propio del acueducto) y así funciona la cookie de sesión.
NEXT_PUBLIC_API_URL="/api/v1"

# Adónde reenvía Next.js las peticiones de /api/v1 (dirección interna de la API, no pública).
API_INTERNAL_URL="http://localhost:4000"

# Dirección pública de la plataforma (registro y superadmin). Los acueductos usan {slug}.<este dominio>.
# Debe coincidir con PLATFORM_WEB_ORIGIN de la API. En producción, p. ej. https://aguamata.co
NEXT_PUBLIC_PLATFORM_ORIGIN="http://localhost:3000"
