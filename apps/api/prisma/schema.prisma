// Esquema "platform": plano de control del SaaS (organizaciones, planes, suscripciones, auditoría).
// Esquema "tenant": datos operativos de cada acueducto. TODA tabla aquí lleva organization_id y RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["platform", "tenant"]
}

// ───────────────────────────── PLATFORM ─────────────────────────────

enum OrgStatus {
  onboarding
  active
  suspended
  deactivated

  @@schema("platform")
}

model Organization {
  id                    String    @id @default(uuid()) @db.Uuid
  slug                  String    @unique
  name                  String
  legalName             String    @map("legal_name")
  nit                   String    @unique
  nitDv                 Int       @map("nit_dv")
  department            String
  municipality          String
  organizationType      String    @map("organization_type")
  legalNature           String?   @map("legal_nature")
  providerType          String?   @map("provider_type")
  areaType              String?   @map("area_type") // urbana | rural | mixta
  altitudeMasl          Int?      @map("altitude_masl")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  estimatedSubscribers  Int       @default(0) @map("estimated_subscribers")
  contactEmail          String    @map("contact_email")
  contactPhone          String    @map("contact_phone")
  status                OrgStatus @default(onboarding)
  branding              Json      @default("{}")
  /// Intereses de mora, cargo de reconexión y umbral de suspensión (ver collectionSettingsSchema).
  collectionSettings    Json      @default("{}") @map("collection_settings")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  memberships        Membership[]
  subscriptions      Subscription[]
  overrides          OrgEntitlementOverride[]
  subscribers        Subscriber[]
  complianceItems    ComplianceItem[]
  tariffSchedules    TariffSchedule[]
  domains            OrganizationDomain[]
  meters             Meter[]
  meterReadings      MeterReading[]
  billingPeriods     BillingPeriod[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  subscriberCharges  SubscriberCharge[]
  serviceEvents      ServiceEvent[]
  invitations        Invitation[]
  backgroundJobs     BackgroundJob[]
  saasInvoices       SaasInvoice[]
  saasPayments       SaasPayment[]

  @@map("organizations")
  @@schema("platform")
}

/// Dominios propios de un acueducto (p. ej. portal.acueductoelencano.org).
/// El subdominio por defecto {slug}.{dominio de la plataforma} no se guarda aquí: se deriva del slug.
model OrganizationDomain {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  hostname          String    @unique
  status            String    @default("pending") // pending | verified | failed
  verificationToken String    @map("verification_token")
  isPrimary         Boolean   @default(false) @map("is_primary")
  verifiedAt        DateTime? @map("verified_at")
  lastCheckedAt     DateTime? @map("last_checked_at")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_domains")
  @@schema("platform")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  fullName        String    @map("full_name")
  passwordHash    String    @map("password_hash")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordReset[]

  @@map("users")
  @@schema("platform")
}

/// Sesión de navegador. La cookie httpOnly lleva un token aleatorio; aquí solo se guarda su hash SHA-256.
/// Revocar una sesión (salir, cambiar o recuperar la contraseña) la invalida en la siguiente petición.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  /// Acueducto activo de la sesión (null = sin acueducto, p. ej. superadmin).
  organizationId String?   @map("organization_id") @db.Uuid
  /// Si la sesión es de soporte: el permiso aprobado por el acueducto que la respalda.
  supportGrantId String?   @map("support_grant_id") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("platform")
}

/// Enlace de recuperación de contraseña: un solo uso, vence en 1 hora. Solo se guarda el hash.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
  @@schema("platform")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String // owner | admin | operator | reader
  /// active | disabled. Un acceso desactivado se rechaza en la siguiente petición (el guard revisa la BD).
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
  @@schema("platform")
}

/// Invitación de personal a un acueducto. Solo se guarda el hash del token; el enlace se muestra una vez.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String?   @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
  @@schema("platform")
}

model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique // free | basic | pro | advanced | custom_xxx
  name            String
  priceMonthlyCop Int      @default(0) @map("price_monthly_cop")
  priceYearlyCop  Int      @default(0) @map("price_yearly_cop")
  trialDays       Int      @default(0) @map("trial_days")
  isPublic        Boolean  @default(true) @map("is_public")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  features      PlanFeature[]
  limits        PlanLimit[]
  subscriptions Subscription[]
  saasInvoices  SaasInvoice[]

  @@map("plans")
  @@schema("platform")
}

model PlanFeature {
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
  @@schema("platform")
}

model PlanLimit {
  planId   String @map("plan_id") @db.Uuid
  limitKey String @map("limit_key")
  value    Int // -1 = ilimitado
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, limitKey])
  @@map("plan_limits")
  @@schema("platform")
}

/// Excepciones por organización (plan personalizado, promociones) sin crear un plan nuevo.
model OrgEntitlementOverride {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String // feature:<key> o limit:<key>
  value          Int // feature: 0/1; limit: valor (-1 = ilimitado)
  expiresAt      DateTime?    @map("expires_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("org_entitlement_overrides")
  @@schema("platform")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled

  @@schema("platform")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  billingCycle       String             @default("monthly") @map("billing_cycle")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  graceEndsAt        DateTime?          @map("grace_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  invoices     SaasInvoice[]

  @@index([organizationId, status])
  @@map("subscriptions")
  @@schema("platform")
}

/// Factura del SaaS a un acueducto por un período de su suscripción. Distinta de las facturas del agua (tenant.invoices).
model SaasInvoice {
  id               String    @id @default(uuid()) @db.Uuid
  /// Consecutivo global de la plataforma.
  number           Int       @unique @default(autoincrement())
  organizationId   String    @map("organization_id") @db.Uuid
  subscriptionId   String    @map("subscription_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  billingCycle     String    @map("billing_cycle") // monthly | yearly
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  amountCop        Int       @map("amount_cop")
  status           String    @default("pending") // pending | in_review | paid | void
  dueDate          DateTime  @map("due_date")
  paidAt           DateTime? @map("paid_at")
  paymentMethod    String?   @map("payment_method") // mercadopago | transfer | manual
  paymentReference String?   @map("payment_reference")
  confirmedById    String?   @map("confirmed_by_id") @db.Uuid
  voidedAt         DateTime? @map("voided_at")
  voidReason       String?   @map("void_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  payments     SaasPayment[]

  @@index([organizationId, status])
  @@index([status, dueDate])
  @@map("saas_invoices")
  @@schema("platform")
}

/// Intento o registro de pago de una factura del SaaS: Mercado Pago, transferencia reportada o registro manual.
model SaasPayment {
  id                   String    @id @default(uuid()) @db.Uuid
  invoiceId            String    @map("invoice_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  method               String // mercadopago | transfer | manual
  status               String    @default("pending") // pending | in_review | approved | rejected
  amountCop            Int       @map("amount_cop")
  /// id del pago en Mercado Pago (único: el webhook puede llegar varias veces).
  providerPaymentId    String?   @unique @map("provider_payment_id")
  providerPreferenceId String?   @map("provider_preference_id")
  providerStatus       String?   @map("provider_status")
  reference            String?
  paidAt               DateTime? @map("paid_at")
  /// Comprobante de transferencia en el almacenamiento (nunca se expone la clave).
  proofKey             String?   @map("proof_key")
  proofType            String?   @map("proof_type")
  notes                String?
  reviewedById         String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at")
  rejectReason         String?   @map("reject_reason")
  createdById          String?   @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  invoice      SaasInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, method])
  @@map("saas_payments")
  @@schema("platform")
}

/// Configuración de la plataforma (datos, no código): días de gracia, cuenta para transferencias…
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("platform")
}

/// Acceso excepcional de soporte a datos de un tenant: solicitado, aprobado por el tenant, con TTL y auditado.
model SupportAccessGrant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestedById  String    @map("requested_by_id") @db.Uuid
  approvedById   String?   @map("approved_by_id") @db.Uuid
  reason         String
  scope          String    @default("read")
  status         String    @default("pending") // pending | approved | rejected | revoked
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("support_access_grants")
  @@schema("platform")
}

/// Tarea en segundo plano que el usuario sigue (importaciones, PDF masivos…). La cola es BullMQ (Redis);
/// aquí quedan el estado, el avance y el resultado. Tabla de plataforma: cada consulta filtra por organizationId.
model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  status         String    @default("queued") // queued | running | done | failed
  progress       Int       @default(0) // 0-100
  input          Json      @default("{}")
  result         Json?
  error          String?
  attempts       Int       @default(0)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("background_jobs")
  @@schema("platform")
}

/// Bitácora append-only (UPDATE/DELETE revocados al rol de la app en la migración).
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  occurredAt     DateTime @default(now()) @map("occurred_at")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  entity         String?
  entityId       String?  @map("entity_id")
  data           Json?
  ip             String?

  @@index([organizationId, occurredAt])
  @@map("audit_logs")
  @@schema("platform")
}

/// Catálogo regulatorio (datos, no código). appliesTo define a quién aplica:
/// { organizationTypes?, legalNatures?, providerTypes?, areaTypes?, minSubscribers?, maxSubscribers? }
model RegulatoryObligation {
  code        String   @id
  title       String
  description String
  authority   String
  legalBasis  String   @map("legal_basis")
  frequency   String
  appliesTo   Json     @default("{}") @map("applies_to")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("regulatory_obligations")
  @@schema("platform")
}

// ───────────────────────────── TENANT ─────────────────────────────

/// Lista de obligaciones de cada acueducto, generada a partir de su perfil jurídico y regulatorio.
model ComplianceItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  obligationCode String    @map("obligation_code")
  status         String    @default("pending") // pending | in_progress | done | not_applicable
  dueDate        DateTime? @map("due_date") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, obligationCode])
  @@map("compliance_items")
  @@schema("tenant")
}

/// Tarifa del servicio de acueducto. Valores en COP. stratumFactors: % por estrato/uso
/// (negativo = subsidio, positivo = contribución), p. ej. { "1": -50, "2": -40, "5": 50 }.
model TariffSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  name               String
  effectiveFrom      DateTime @map("effective_from") @db.Date
  billingPeriod      String   @map("billing_period") // monthly | bimonthly
  basicConsumptionM3 Int      @map("basic_consumption_m3")
  fixedCharge        Decimal  @map("fixed_charge") @db.Decimal(14, 2)
  rateBasic          Decimal  @map("rate_basic") @db.Decimal(14, 2)
  rateComplementary  Decimal  @map("rate_complementary") @db.Decimal(14, 2)
  rateSumptuary      Decimal  @map("rate_sumptuary") @db.Decimal(14, 2)
  /// m³ desde los que se cobra consumo suntuario. Si es null se usa 2 × consumo básico.
  sumptuaryFromM3    Int?     @map("sumptuary_from_m3")
  stratumFactors     Json     @default("{}") @map("stratum_factors")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  billingPeriods BillingPeriod[]

  @@unique([id, organizationId], map: "tariff_schedules_id_org_key")
  @@index([organizationId, isActive])
  @@map("tariff_schedules")
  @@schema("tenant")
}

model Subscriber {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  fullName       String   @map("full_name")
  documentNumber String   @map("document_number")
  address        String
  stratum        Int?
  /// residencial | comercial | industrial | oficial. Residencial usa el factor de su estrato.
  usage          String   @default("residencial")
  /// connected | suspended (servicio de agua). Distinto de status (si se factura o no).
  serviceStatus  String   @default("connected") @map("service_status")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meters        Meter[]
  readings      MeterReading[]
  invoices      Invoice[]
  payments      Payment[]
  charges       SubscriberCharge[]
  serviceEvents ServiceEvent[]

  @@unique([id, organizationId], map: "subscribers_id_org_key")
  @@unique([organizationId, code])
  @@index([organizationId, documentNumber])
  @@map("subscribers")
  @@schema("tenant")
}

/// Medidor instalado en el predio de un suscriptor. Solo puede haber uno activo por suscriptor
/// (índice único parcial en la migración).
model Meter {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriberId   String    @map("subscriber_id") @db.Uuid
  serial         String
  brand          String?
  diameter       String? // p. ej. 1/2"
  installedAt    DateTime  @map("installed_at") @db.Date
  initialReading Decimal   @default(0) @map("initial_reading") @db.Decimal(12, 2)
  status         String    @default("active") // active | removed | damaged
  removedAt      DateTime? @map("removed_at") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriber   Subscriber     @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "meters_subscriber_same_org_fkey")
  readings     MeterReading[]

  @@unique([id, organizationId], map: "meters_id_org_key")
  @@unique([organizationId, serial])
  @@index([organizationId, subscriberId])
  @@map("meters")
  @@schema("tenant")
}

/// Lectura de un medidor en un período de facturación (YYYY-MM). Una por medidor y período.
/// Si no se pudo leer (predio cerrado, medidor dañado) se registra la causal y el consumo se estima por promedio.
model MeterReading {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  meterId        String   @map("meter_id") @db.Uuid
  subscriberId   String   @map("subscriber_id") @db.Uuid
  period         String // YYYY-MM
  readingDate    DateTime @map("reading_date") @db.Date
  value          Decimal? @db.Decimal(12, 2)
  previousValue  Decimal  @map("previous_value") @db.Decimal(12, 2)
  consumptionM3  Decimal  @map("consumption_m3") @db.Decimal(12, 2)
  isEstimated    Boolean  @default(false) @map("is_estimated")
  observation    String? // código de causal de no lectura u observación
  anomaly        String? // negative | high | zero | estimated
  source         String   @default("manual") // manual | import | app
  readerUserId   String?  @map("reader_user_id") @db.Uuid
  locked         Boolean  @default(false) // true cuando el período se factura
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meter        Meter        @relation(fields: [meterId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "readings_meter_same_org_fkey")
  subscriber   Subscriber   @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "readings_subscriber_same_org_fkey")

  @@unique([organizationId, meterId, period])
  @@index([organizationId, period])
  @@map("meter_readings")
  @@schema("tenant")
}

/// Corrida de facturación de un período. Una por acueducto y período (se reutiliza si se anula y se vuelve a emitir).
model BillingPeriod {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  period             String // YYYY-MM
  status             String    @default("issued") // issued | voided
  tariffScheduleId   String    @map("tariff_schedule_id") @db.Uuid
  issueDate          DateTime  @map("issue_date") @db.Date
  dueDate            DateTime  @map("due_date") @db.Date
  options            Json      @default("{}")
  invoiceCount       Int       @default(0) @map("invoice_count")
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(16, 2)
  subsidyAmount      Decimal   @default(0) @map("subsidy_amount") @db.Decimal(16, 2)
  contributionAmount Decimal   @default(0) @map("contribution_amount") @db.Decimal(16, 2)
  consumptionM3      Decimal   @default(0) @map("consumption_m3") @db.Decimal(14, 2)
  issuedById         String?   @map("issued_by_id") @db.Uuid
  issuedAt           DateTime  @default(now()) @map("issued_at")
  voidedAt           DateTime? @map("voided_at")
  voidReason         String?   @map("void_reason")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tariff       TariffSchedule @relation(fields: [tariffScheduleId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "billing_periods_tariff_same_org_fkey")
  invoices     Invoice[]

  @@unique([id, organizationId], map: "billing_periods_id_org_key")
  @@unique([organizationId, period])
  @@map("billing_periods")
  @@schema("tenant")
}

/// Factura del servicio de acueducto de un suscriptor. Los datos del suscriptor y de la lectura se copian
/// (snapshot) para que la factura no cambie si luego se edita el suscriptor.
model Invoice {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  billingPeriodId    String   @map("billing_period_id") @db.Uuid
  subscriberId       String   @map("subscriber_id") @db.Uuid
  number             Int
  period             String
  issueDate          DateTime @map("issue_date") @db.Date
  dueDate            DateTime @map("due_date") @db.Date
  status             String   @default("issued") // issued | paid | void
  subscriberSnapshot Json     @map("subscriber_snapshot")
  readingSnapshot    Json     @map("reading_snapshot")
  consumptionM3      Decimal  @map("consumption_m3") @db.Decimal(12, 2)
  subtotal           Decimal  @db.Decimal(14, 2)
  subsidyAmount      Decimal  @default(0) @map("subsidy_amount") @db.Decimal(14, 2)
  contributionAmount Decimal  @default(0) @map("contribution_amount") @db.Decimal(14, 2)
  total              Decimal  @db.Decimal(14, 2)
  /// Lo abonado a ESTA factura. Saldo = total - paidAmount. status: issued → partial → paid.
  paidAmount         Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// Informativo: deuda de facturas anteriores al momento de emitir (se muestra en el recibo).
  previousBalance    Decimal  @default(0) @map("previous_balance") @db.Decimal(14, 2)
  /// Parte del total que corresponde a intereses de mora (no genera intereses: sin anatocismo).
  interestAmount     Decimal  @default(0) @map("interest_amount") @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  billingPeriod BillingPeriod       @relation(fields: [billingPeriodId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "invoices_period_same_org_fkey")
  subscriber    Subscriber          @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "invoices_subscriber_same_org_fkey")
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  charges       SubscriberCharge[]

  @@unique([id, organizationId], map: "invoices_id_org_key")
  @@unique([organizationId, number])
  @@index([organizationId, period])
  @@index([organizationId, subscriberId])
  @@map("invoices")
  @@schema("tenant")
}

model InvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  concept        String // cargo_fijo | consumo_basico | consumo_complementario | consumo_suntuario | subsidio | contribucion
  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  amount         Decimal @db.Decimal(14, 2)
  sortOrder      Int     @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "invoice_lines_invoice_same_org_fkey")

  @@index([organizationId, invoiceId])
  @@map("invoice_lines")
  @@schema("tenant")
}

/// Pago recibido de un suscriptor (comprobante de pago). Se aplica a sus facturas pendientes, la más antigua primero.
model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriberId   String    @map("subscriber_id") @db.Uuid
  number         Int // consecutivo de comprobante por acueducto
  paidAt         DateTime  @map("paid_at") @db.Date
  amount         Decimal   @db.Decimal(14, 2)
  method         String // efectivo | transferencia | consignacion | pse | otro
  reference      String?
  notes          String?
  status         String    @default("applied") // applied | void
  receivedById   String?   @map("received_by_id") @db.Uuid
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriber   Subscriber          @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "payments_subscriber_same_org_fkey")
  allocations  PaymentAllocation[]

  @@unique([id, organizationId], map: "payments_id_org_key")
  @@unique([organizationId, number])
  @@index([organizationId, paidAt])
  @@index([organizationId, subscriberId])
  @@map("payments")
  @@schema("tenant")
}

/// Parte de un pago aplicada a una factura.
model PaymentAllocation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  paymentId      String  @map("payment_id") @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  amount         Decimal @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "allocations_payment_same_org_fkey")
  invoice      Invoice      @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "allocations_invoice_same_org_fkey")

  @@index([organizationId, paymentId])
  @@index([organizationId, invoiceId])
  @@map("payment_allocations")
  @@schema("tenant")
}

/// Cargo adicional pendiente de facturar (reconexión, otros). Se incluye en la siguiente factura del suscriptor.
model SubscriberCharge {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  subscriberId    String    @map("subscriber_id") @db.Uuid
  concept         String // reconexion | otro
  description     String
  amount          Decimal   @db.Decimal(14, 2)
  billedInvoiceId String?   @map("billed_invoice_id") @db.Uuid
  createdById     String?   @map("created_by_id") @db.Uuid
  voidedAt        DateTime? @map("voided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriber    Subscriber     @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "charges_subscriber_same_org_fkey")
  billedInvoice Invoice?       @relation(fields: [billedInvoiceId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "charges_invoice_same_org_fkey")
  serviceEvents ServiceEvent[]

  @@unique([id, organizationId], map: "subscriber_charges_id_org_key")
  @@index([organizationId, subscriberId])
  @@map("subscriber_charges")
  @@schema("tenant")
}

/// Historial de suspensiones y reconexiones del servicio.
model ServiceEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriberId   String   @map("subscriber_id") @db.Uuid
  type           String // suspension | reconnection
  date           DateTime @db.Date
  reason         String
  notes          String?
  balanceAtEvent Decimal  @default(0) @map("balance_at_event") @db.Decimal(14, 2)
  chargeId       String?  @map("charge_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriber   Subscriber        @relation(fields: [subscriberId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "service_events_subscriber_same_org_fkey")
  charge       SubscriberCharge? @relation(fields: [chargeId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "service_events_charge_same_org_fkey")

  @@index([organizationId, subscriberId, date])
  @@map("service_events")
  @@schema("tenant")
}
