# Rol de la aplicación: SIN privilegios de BYPASSRLS. Todas las consultas pasan por Row Level Security.
DATABASE_URL="postgresql://aguamata_app:app_dev_pw@localhost:5433/aguamata?schema=public"
# Rol dueño de las tablas: solo para migraciones y seed. Nunca lo usa la API en tiempo de ejecución.
DIRECT_DATABASE_URL="postgresql://aguamata_owner:owner_dev_pw@localhost:5433/aguamata?schema=public"
REDIS_URL="redis://localhost:6380"
# Cola de tareas (BullMQ sobre Redis). inline = ejecuta en el acto, sin Redis (pruebas).
# QUEUE_DRIVER="bullmq"
# QUEUE_NAME="aguamata"
# El worker corre en este proceso por defecto. Para un worker aparte: WORKER_ENABLED=false aquí y true allá.
# WORKER_ENABLED="true"
# WORKER_CONCURRENCY="4"

# Archivos: local (carpeta STORAGE_DIR) | s3 (Amazon S3 o compatible: R2, MinIO, Spaces). El bucket debe ser privado.
STORAGE_DRIVER="local"
# STORAGE_DIR="storage"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""            # p. ej. https://<cuenta>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE="false"  # true para MinIO
# Cookie de sesión con Secure. Por defecto se deduce (HTTPS o X-Forwarded-Proto: https).
# COOKIE_SECURE="true"
# Proxies de confianza para X-Forwarded-* (la web de Next.js en el mismo equipo = loopback).
# TRUST_PROXY="loopback"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Origen público de la web de la plataforma. Los acueductos usan {slug}.<host> por defecto.
PLATFORM_WEB_ORIGIN="http://localhost:3000"

# Correo: log (no envía, por defecto) | ses | smtp
MAIL_PROVIDER="log"
MAIL_FROM="AguaMata <no-responder@tu-dominio.co>"
# Amazon SES (remitente verificado en SES). Credenciales por la cadena estándar de AWS o estas variables:
AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# SES_CONFIGURATION_SET=""
# SMTP: o SMTP_URL="smtp://usuario:clave@servidor:587", o por partes:
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# Cobro del SaaS con Mercado Pago (Checkout Pro). Sin MP_ACCESS_TOKEN solo se ofrece la transferencia.
# MP_ACCESS_TOKEN=""          # TEST-... para pruebas, APP_USR-... en producción
# MP_WEBHOOK_SECRET=""        # clave secreta del webhook (Tus integraciones → Webhooks)
# URL pública de la API para el webhook de Mercado Pago (no se envía si es localhost).
# API_PUBLIC_URL="https://api.tu-dominio.co"

# Cifrado de secretos guardados en la BD (p. ej. la clave técnica de la DIAN). Obligatoria en producción.
# Generar con: openssl rand -base64 32
# APP_ENCRYPTION_KEY=""
