# Configuración de producción para docker-compose.prod.yml. Copia este archivo a deploy/.env y complétalo.
# NUNCA subas deploy/.env a git (ya está en .gitignore).
# Contraseñas: usa solo letras y números (van dentro de URLs). Genera cada una con: openssl rand -hex 24

# ── Dominio ──
# Dominio de la plataforma. Los acueductos quedan en {slug}.<este dominio>.
PLATFORM_DOMAIN=aguamata.co
# Correo para Let's Encrypt (avisos de certificados).
ACME_EMAIL=admin@aguamata.co

# ── Base de datos ──
POSTGRES_PASSWORD=
AGUAMATA_OWNER_PASSWORD=
AGUAMATA_APP_PASSWORD=
BACKUP_RETENTION_DAYS=14

# ── Secretos ──
# Cifra la clave técnica de la DIAN. GUÁRDALA APARTE: si se pierde no se puede recuperar. openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Superadmin (solo lo usa el seed, la primera vez; mínimo 12 caracteres) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Correo (obligatorio): ses o smtp ──
MAIL_PROVIDER=ses
MAIL_FROM=AguaMata <no-responder@aguamata.co>
# Amazon SES (y S3, si lo usas):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
# O SMTP:
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ── Archivos: local (volumen del servidor, incluido en el respaldo del VPS) o s3 ──
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Mercado Pago (opcional; sin token solo se ofrece la transferencia) ──
# Webhook a registrar en Mercado Pago: https://<PLATFORM_DOMAIN>/api/v1/public/payments/mercadopago/webhook
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
